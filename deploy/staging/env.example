# =============================================================================
# STAGING env template — copy to deploy/staging/.env.staging and fill in.
# =============================================================================
#
#   cd deploy/staging && cp env.example .env.staging
#
# docker-compose.staging.yml reads this file TWICE:
#   - as `env_file:` for every app container (the app's own configuration), and
#   - as compose's interpolation source for ${...} (ports, DB name, MQTT).
# Compose auto-loads `.env` for interpolation, not `.env.staging`, so pass it
# explicitly when you need interpolation of the non-app vars:
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d
#
# NO REAL VALUES BELOW. Every secret is a placeholder. `.env.staging` must
# never be committed (repo .gitignore already excludes .env*).
#
# Legend:  [=PROD]  same value/shape as production
#          [≠PROD]  MUST differ from production — read the comment
# =============================================================================

# --- Django core -------------------------------------------------------------
# [≠PROD] Generate a FRESH key. Reusing prod's SECRET_KEY would make staging
# able to mint tokens/sessions that prod accepts — that is a prod compromise.
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-freshly-generated-staging-secret

# [≠PROD] DJANGO_ENV has only three valid values (dev|prod|test) — there is NO
# "staging" settings module; agriapi/settings/__init__.py raises on anything
# else. Staging runs the PROD settings module with staging values, which is
# what makes it a faithful preprod. This is also set in the compose file.
DJANGO_ENV=prod
DEBUG=False

# [≠PROD] prod lists back.agrogo-datafarm.com. `agri-api-web-staging` is needed
# so in-network callers (and the healthcheck's Host header) are accepted.
ALLOWED_HOSTS=staging.agrogo-datafarm.com,localhost,127.0.0.1,agri-api-web-staging

# [≠PROD] Only staging front-ends. Never list the prod app origins here.
CORS_ALLOWED_ORIGINS=https://staging-app.agrogo-datafarm.com
CSRF_TRUSTED_ORIGINS=https://staging.agrogo-datafarm.com,https://staging-app.agrogo-datafarm.com

# --- Database ----------------------------------------------------------------
# [≠PROD] The `agrydata-staging` container from docker-compose.staging.yml, NOT
# prod's `agrydata`. The staging network cannot even resolve `agrydata`, so a
# copy-paste of the prod values fails closed rather than writing to prod.
USE_POSTGRES=True
POSTGRES_DB=agrilogy_staging
POSTGRES_USER=agrilogy_staging
POSTGRES_PASSWORD=replace-with-a-strong-staging-db-password
POSTGRES_HOST=agrydata-staging
POSTGRES_PORT=5432
# [≠PROD] Local container has no TLS; prod's managed endpoint uses "require".
POSTGRES_SSLMODE=disable

# [≠PROD] Alembic (agri-db) owns the schema. Staging is exactly where a
# migration should be proven before prod, so leave this ON here — prod keeps it
# gated OFF until the cutover in docs/MIGRATIONS_PROD_CUTOVER.md.
RUN_DB_MIGRATIONS=true
# One-time only, on a DB that already has tables but no alembic_version row.
# A freshly created staging DB should be migrated from base instead — leave
# this EMPTY unless you restored a prod dump. See README.md.
ALEMBIC_STAMP_REV=

# --- Celery / Redis ----------------------------------------------------------
# [≠PROD] `redis-staging`, its own broker. Sharing prod's redis would put this
# worker on the same `agriapi` queue as prod's and it would execute PRODUCTION
# tasks. Also set in the compose file; kept here so `docker run` debugging of a
# single container inherits the right value.
CELERY_BROKER_URL=redis://redis-staging:6379/0
CELERY_RESULT_BACKEND=redis://redis-staging:6379/0
CELERY_SCHEDULE_MODE=

# --- Email -------------------------------------------------------------------
# [≠PROD] prod defaults to the Resend HTTP backend and sends for real. Staging
# forces SMTP into the mailpit-staging sink so no customer can ever receive a
# staging email. Read them at http://127.0.0.1:9025 (SSH tunnel).
# NOTE: prod settings call _required() on EMAIL_HOST_USER/PASSWORD when the SMTP
# backend is selected, so these must be NON-EMPTY. Mailpit accepts anything.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit-staging
EMAIL_PORT=1025
EMAIL_HOST_USER=staging
EMAIL_HOST_PASSWORD=staging
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Agrilogy STAGING <noreply@staging.agrogo-datafarm.com>
# [≠PROD] Leave EMPTY. A real key here bypasses mailpit and mails customers.
RESEND_API_KEY=
INTERNAL_FEEDBACK_EMAILS=

# --- SMS / WhatsApp ----------------------------------------------------------
# [≠PROD] Leave ALL THREE EMPTY. Twilio does not pass through mailpit — a
# populated credential means staging sends real WhatsApp/SMS to real numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# --- MQTT ingest -------------------------------------------------------------
# [≠PROD] The subscriber is behind the `mqtt` compose profile and does not
# start by default. Leave MQTT_HOST EMPTY unless you have read the hazard note
# in docker-compose.staging.yml: pointing it at the PROD ChirpStack broker
# double-processes live uplinks into the staging DB, and a duplicate
# MQTT_CLIENT_ID gets the PROD subscriber disconnected by the broker.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# [≠PROD] prod uses the default `agri-api-ingest`. MUST differ — see above.
MQTT_CLIENT_ID=agri-api-ingest-staging
MQTT_QOS=1
# [≠PROD] prod uses `agrilogy`. A distinct prefix keeps the generic sensor
# topic tree disjoint from prod's.
MQTT_TOPIC_PREFIX=agrilogy-staging
MQTT_CHIRPSTACK_TOPIC=application/+/device/+/event/up

# --- Feature flags -----------------------------------------------------------
# [≠PROD] Leave False on staging too: staging should be validated against REAL
# ingested data, not the random simulator. Flip to True only for a demo run.
ENABLE_SENSOR_SIMULATOR=False
# [≠PROD] Keep False so staging never actuates physical valves.
IRRIGATION_DISPATCH_ENABLED=false
ZONE_IDLE_THRESHOLD_HOURS=
ZONE_IDLE_REFLAG_HOURS=

# --- AI assistant ------------------------------------------------------------
# [=PROD shape] Use a separate key if the provider supports it, so staging
# traffic does not consume the production quota. Empty = assistant disabled.
AI_API_KEY=
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT=20

# --- Logging -----------------------------------------------------------------
# [=PROD] JSON so Promtail/Loki parse staging lines with the same pipeline.
# The `container` label is what separates staging from prod in Grafana.
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Runtime -----------------------------------------------------------------
# [≠PROD] Fewer workers than prod: staging shares one droplet with production
# and must not compete for CPU/RAM with it.
GUNICORN_WORKERS=2
UVICORN_WORKERS=1
DJANGO_TIME_ZONE=Africa/Casablanca

# --- Build-time (shell env, NOT read by the containers) ----------------------
# Export before `up --build`; the Dockerfile consumes it as a build secret to
# fetch the PRIVATE agri-db. Same token as prod (read-only).
#   export AGRI_DB_RO_TOKEN=...
