# Copy to deploy/observability/.env (compose auto-reads it for interpolation).
# Only GF_SECURITY_ADMIN_PASSWORD is required; the rest are optional.

# --- Grafana login (REQUIRED) ------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-to-a-strong-password
GF_SERVER_ROOT_URL=https://grafana.agrogo-datafarm.com

# --- Optional: Postgres datasource (deliveries-history panels) ---------------
# Point at the SAME Supabase pooler back/.env uses. Leave blank to skip — the
# Loki dashboards work without it.
GF_POSTGRES_HOST=
GF_POSTGRES_PORT=5432
GF_POSTGRES_DB=
GF_POSTGRES_USER=
GF_POSTGRES_PASSWORD=

# --- Optional: alert delivery webhook ----------------------------------------
# The droplet blocks outbound SMTP, so email contact points won't work. Wire
# the Resend-429 alert to a webhook (Slack/Discord/n8n/etc.) — see README.md
# "Alerting" for the contactpoints.yml snippet that consumes this.
GF_ALERT_WEBHOOK_URL=
