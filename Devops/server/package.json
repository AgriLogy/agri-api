{
  "name": "agri-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP ingest gateway: translates Router0X-format payloads into the Bivocom v1 wire format and forwards to agri-api.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
