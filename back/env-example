SECRET_KEY
DEBUG=
ALLOWED_HOSTS
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
USE_POSTGRES=True
# Supabase Session pooler (eu-central-1). Find these in
# Supabase Studio -> Project -> Connect -> Session pooler.
POSTGRES_DB=postgres
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=
POSTGRES_HOST=aws-0-eu-central-1.pooler.supabase.com
POSTGRES_PORT=5432
CELERY_SCHEDULE_MODE=
# Set to True ONLY for local dev without hardware — runs the random sensor
# simulator. Leave blank/False on any server so graphs/ET0/notifications use
# REAL ingested data (Bivocom / LoRaWAN).
ENABLE_SENSOR_SIMULATOR=

# ----- Email (notifications) ---------------------------------------------------
# DEFAULT_FROM_EMAIL is what shows up in the From header.
DEFAULT_FROM_EMAIL=Agrilogy <noreply@agrilogy.local>

# When DEBUG=True the code defaults to the console backend (emails print to
# stdout). Set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend to
# force SMTP delivery during local testing — that's what the Mailpit setup
# needs. The same var also takes effect in production.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Mailpit (docker compose service): SMTP on host :1025, web UI on :8025.
# When running Django INSIDE docker compose, set EMAIL_HOST=mailpit.
# When running Django on the host (make dev), use EMAIL_HOST=localhost.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DJANGO_ENV=dev

# ALLOWED_HOSTS must include the docker-compose service name `agri-api-web`
# so the agri-bridge container can forward POSTs without DisallowedHost
# (Django rejects Host headers not in ALLOWED_HOSTS).
# When you copy this file to back/.env, set:
# ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,agri-api-web
